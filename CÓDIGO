//Inclusión de librerías
#include <Arduino.h>
#include <stdint.h>

//Definición de pines para los leds
#define LED_V 4
#define LED_A 16
#define LED_R 17

//Definición de pines para la entrada de señales del LM35, amplificadas y comparadas
#define C1 32
#define C2 33
#define temp 35

void setup() {
  //Inicio de comunicación serial
  Serial.begin(115200);

  //Definición de entradas (señal amplificada y comparada del LM35)
  pinMode(C1, INPUT);
  pinMode(C2, INPUT);
  pinMode(temp, INPUT);

  //Definición de pines de salida
  pinMode(LED_V, OUTPUT);
  pinMode(LED_R, OUTPUT);
  pinMode(LED_A, OUTPUT);

  //Resolución del ADC a 12 bits
  analogReadResolution(12);
}

void loop() {
  //Lectura de la entrada digital de los comparadores 
  int lecturaC1 = digitalRead(C1);
  int lecturaC2 = digitalRead(C2);

  //Temperatura menor a 36°C
  if (lecturaC1 == LOW && lecturaC2 == LOW) {
    digitalWrite(LED_V, HIGH);
    digitalWrite(LED_R, LOW);
    digitalWrite(LED_A, LOW);
  }
  //Temperatura entre 36°C y 40°C
  else if (lecturaC1 == HIGH && lecturaC2 == LOW) {
    digitalWrite(LED_V, LOW);
    digitalWrite(LED_R, LOW);
    digitalWrite(LED_A, HIGH);
  }
  //Temperatura mayor a 40°C
  else if (lecturaC2 == HIGH) {
    digitalWrite(LED_V, LOW);
    digitalWrite(LED_R, HIGH);
    digitalWrite(LED_A, LOW);
  }
  //delay(300);

  //Lectura del valor de temperatura del LM35
  int lecturaTemp = analogRead(temp);
  //Cálculo de la temperatura en grados Celsius
  float voltaje = (lecturaTemp / 3.3) * 4095;
  float temperaturaC = voltaje / 0.05; //Por la ganancia de 5
  //Impresión de la temperatura en el monitor serial
  Serial.print("Temperatura: ");
  Serial.print(temperaturaC);
  Serial.println("°C");
  delay(1000);
}
